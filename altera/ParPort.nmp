let arch = "altera"
let component = "ParPort"
let copyright = "University of Toulouse"
let date = "2026/07/17"
let license = "GPLv3"
let version = "1.0"

type bit = card(1)
type word = card(32)

let INPUT = 0
let OUTPUT = 1


reg DIR[1, word]
	offset = 0x4
	init = 0
	update_on_write = 1

reg DAR[1, word]
	offset = 0x0
	init = 0
	on_write = {
		__VALUE = (__VALUE & DIR) | (DAR & ~DIR);
	}
	update_on_write = 1

reg IMR[1, word]
	offset = 0x8
	init = 0
	update_on_write = 1

reg ECR[1, word]
	offset = 0xc
	init = 0
	on_write = {
		ECR = 0;
	}
	update_on_write = 1

port IRQ(1, bit)

port PIN(32, bit)
	label = "P%d"
	on_input = {
		if DIR<__INDEX..__INDEX> == INPUT then
			DAR<__INDEX..__INDEX> = __VALUE;
			ECR<__INDEX..__INDEX> = ECR<__INDEX..__INDEX> | __VALUE;
			IRQ = (ECR & ~IMR) != 0;
		endif;
	}

op update()
	action = {
		for i in 0..31 do
			if DIR<i..i> == OUTPUT then
				PIN[i] = DAR<i..i>;
			endif;
		enddo;
	}
