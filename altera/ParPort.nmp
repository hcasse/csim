let arch = "altera"
let component = "ParPort"
let copyright = "University of Toulouse"
let date = "2026/07/17"
let license = "GPLv3"
let version = "1.0"

type bit = card(1)
type word = card(32)

reg DAR[1, word]
	offset = 0x0
	init = 0
	update_on_write = 1

reg DIR[1, word]
	offset = 0x4
	init = 0
	update_on_write = 1

reg IMR[1, word]
	offset = 0x8
	init = 0
	update_on_write = 1

reg ECR[1, word]
	offset = 0xc
	init = 0
	on_write = {
		ECR = 0;
	}
	update_on_write = 1

port IRQ(1, bit)

port PORT(32, bit)
	label = format("PORT%d.%d", __COMP_NUM, __INDEX)
	update_on_write = 1

op update()
	action = {
		for i in 0..31 do
			if DIR<i..i> == 0 then
				DAR<i..i> = PORT[i];
				if PORT[i] then
					ECR<i..i> = 1;
				endif;
			else
				PORT[i] = DAR<i..i>;
			endif;
		enddo;
		IRQ = (ECR & IMR) != 0;
	}
